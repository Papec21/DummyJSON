{
  "openapi": "3.0.0",
  "info": {
    "title": "HappyPathCollection",
    "version": "1.0.0",
    "description": ""
  },
  "servers": [
    {
      "url": "https://dummyjson.com"
    }
  ],
  "paths": {
    "/test": {
      "get": {
        "summary": "Website Works",
        "responses": {}
      }
    },
    "/users/": {
      "get": {
        "summary": "Get Users Limited",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 10
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 5
          }
        ],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "Get Users",
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "User Login",
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "username": "emilys",
                "password": "emilyspass"
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Logged User Info",
        "responses": {},
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "Get Products",
        "responses": {}
      }
    },
    "/products/{productId}": {
      "get": {
        "summary": "Get Single Product",
        "responses": {}
      },
      "parameters": [
        {
          "name": "productId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "example": 10
        }
      ],
      "put": {
        "summary": "Update Product",
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "price": {
                    "type": "number"
                  }
                }
              },
              "example": {
                "title": "RainbowFullOfUnicorns",
                "price": 1999.99
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Product",
        "responses": {}
      }
    },
    "/products/search": {
      "get": {
        "summary": "Search Product",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "phone"
          }
        ],
        "responses": {}
      }
    },
    "/products/add": {
      "post": {
        "summary": "Add Product",
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "price": {
                    "type": "number"
                  }
                }
              },
              "example": {
                "id": 10,
                "title": "avocado",
                "category": "groceries",
                "price": 3.99
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}